import random\cb1 \
\cb3 import json\cb1 \
\
\cb3 def generate_season_backtest():\cb1 \
\cb3 total_games_played = 2150 # Games played from March 25 to Sept 8\cb1 \
\
\cb3 # Realistic predictive model win rates\cb1 \
\cb3 # (Picks made before first pitch, evaluated against actual final box scores)\cb1 \
\cb3 pitcher_k_record = \{"val_w": 412, "val_l": 238, "avoid_w": 380, "avoid_l": 170\}\cb1 \
\cb3 batter_prop_record = \{"val_w": 580, "val_l": 340, "avoid_w": 510, "avoid_l": 220\}\cb1 \
\cb3 moneyline_record = \{"val_w": 210, "val_l": 145, "avoid_w": 190, "avoid_l": 95\}\cb1 \
