\
\cb3 total_val_w = pitcher_k_record["val_w"] + batter_prop_record["val_w"] + moneyline_record["val_w"] + innings_record["val_w"]\cb1 \
\cb3 total_val_l = pitcher_k_record["val_l"] + batter_prop_record["val_l"] + moneyline_record["val_l"] + innings_record["val_l"]\cb1 \
\
\cb3 total_avoid_w = pitcher_k_record["avoid_w"] + batter_prop_record["avoid_w"] + moneyline_record["avoid_w"] + innings_record["avoid_w"]\cb1 \
\cb3 total_avoid_l = pitcher_k_record["avoid_l"] + batter_prop_record["avoid_l"] + moneyline_record["avoid_l"] + innings_record["avoid_l"]\cb1 \
\
\cb3 total_calls = total_val_w + total_val_l + total_avoid_w + total_avoid_l\cb1 \
\cb3 total_correct = total_val_w + total_avoid_w\cb1 \
\
\cb3 results = \{\cb1 \
\cb3 "games_evaluated": total_games_played,\cb1 \
\cb3 "total_calls": total_calls,\cb1 \
\cb3 "total_correct": total_correct,\cb1 \
\cb3 "overall_win_rate": f"\{round((total_correct / total_calls) * 100, 1)\}%",\cb1 \
\cb3 "value_picks_win_rate": f"\{round((total_val_w / (total_val_w + total_val_l)) * 100, 1)\}%",\cb1 \
\cb3 "value_record": f"\{total_val_w\} Correct | \{total_val_l\} Incorrect",\cb1 \
\cb3 "avoid_calls_win_rate": f"\{round((total_avoid_w / (total_avoid_w + total_avoid_l)) * 100, 1)\}%",\cb1 \
\cb3 "avoid_record": f"\{total_avoid_w\} Correct Avoids | \{total_avoid_l\} Failed"\cb1 \
\cb3 \}\cb1 \
\
